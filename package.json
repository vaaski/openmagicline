{
	"name": "openmagicline",
	"description": "Magicline API for everybody.",
	"keywords": [
		"magicline",
		"gym",
		"mysports",
		"reverse-engineered"
	],
	"version": "2.0.0",
	"main": "dist/index.js",
	"license": "MIT",
	"author": "vaaski <admin@vaa.ski>",
	"repository": {
		"type": "git",
		"url": "https://github.com/vaaski/openmagicline.git"
	},
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "bun run build",
		"dev": "bun run test --watch",
		"test": "bun test --preload ./tests/_setup.ts --timeout 10000",
		"test:full": "rimraf test-cookies.txt && bun run test",
		"lint": "biome lint --write ",
		"format": "biome format --write ",
		"typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json"
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@biomejs/biome": "1.9.2",
		"@types/bun": "^1.1.10",
		"@types/debug": "^4.1.12",
		"@types/lodash": "^4.17.9",
		"@types/node": "^20.16.10",
		"@types/ws": "^7.4.7",
		"rimraf": "^3.0.2",
		"tsup": "^6.7.0",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"@stomp/stompjs": "^6.1.2",
		"debug": "^4.3.7",
		"form-data": "^4.0.0",
		"lodash": "^4.17.21",
		"ofetch": "^1.4.0",
		"ws": "^7.5.10"
	}
}
