{
	"name": "openmagicline",
	"version": "2.3.0",
	"description": "Magicline API for everybody.",
	"author": "vaaski <admin@vaa.ski>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/vaaski/openmagicline.git"
	},
	"keywords": [
		"magicline",
		"gym",
		"mysports",
		"reverse-engineered"
	],
	"main": "dist/index.mjs",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bunup",
		"prepublishOnly": "bun run build",
		"dev": "bun run test --watch",
		"test": "bun test --preload ./tests/_setup.ts --timeout 10000",
		"test:full": "rimraf test-cookies.txt && bun run test",
		"typecheck": "tsc --noEmit & tsc -p tests/tsconfig.json",
		"lint": "eslint ."
	},
	"dependencies": {
		"@stomp/stompjs": "^6.1.2",
		"debug": "^4.3.7",
		"lodash": "^4.17.21",
		"ofetch": "^1.4.1",
		"ws": "^7.5.10"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@types/bun": "^1.4.1",
		"@types/debug": "^4.1.12",
		"@types/lodash": "^4.17.12",
		"@types/node": "^20.17.1",
		"@types/ws": "^7.4.7",
		"bunup": "^0.16.32",
		"eslint": "^10.10.0",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-vaaski": "^3.1.1",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	}
}
