{
	"compilerOptions": {
		"target": "ESNext",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"moduleDetection": "force",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"types": [],
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*",
		"types/**/*"
	]
}
