{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "es2022",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"types": [],
		"allowJs": true,
		"strict": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"outDir": "lib",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*", "types/**/*"]
}
